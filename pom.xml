<project xmlns="http://apache.org"
         xmlns:xsi="http://w3.org"
         xsi:schemaLocation="http://apache.org http://apache.org">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>leave-service</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
	<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <sonar.projectKey>leave-service-2024sl70016</sonar.projectKey>
        <sonar.projectName>leave-service-2024sl70016</sonar.projectName>
        <sonar.coverage.jacoco.xmlReportPaths>${project.basedir}/target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
	    <finalName>leave-service</finalName>
	    <plugins>
		    <plugin>
   		   	 <groupId>org.jacoco</groupId>
   			 <artifactId>jacoco-maven-plugin</artifactId>
   			 <version>0.8.12</version>
  			 <executions>
       				 <execution>
           				 <id>prepare-agent</id>
           				 <goals>
               					 <goal>prepare-agent</goal>
           				 </goals>
       				 </execution>
       				 <execution>
           				 <id>report</id>
            		       		 <phase>test</phase>
           				 <goals>
                				<goal>report</goal>
           				 </goals>
       				 </execution>
   			 </executions>
		    </plugin>

    </build>
</project>
